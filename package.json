{
  "name": "pixelworld",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build && esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-server/index.js",
    "start": "node dist-server/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "sim": "node scripts/simulate.mjs"
  },
  "dependencies": {
    "@fontsource/silkscreen": "^5.2.8",
    "@fontsource/space-mono": "^5.2.9",
    "@hono/node-server": "2.1.11",
    "esbuild": "0.28.2",
    "hono": "4.13.21",
    "vite": "8.3.8"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  }
}
